{
  "framework": "vite",
  "devCommand": "vite --host 0.0.0.0 --port $PORT",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/((?!api/|src/|assets/|@vite/|@fs/|@id/|__vite_ping|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
