    "firebase": "^12.14.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1"
  }
